__pycache__/
*.py[cod]
.DS_Store

# ambiente local do uv — recriável por `uv sync`. O `uv.lock` e o `.python-version` SÃO
# versionados: são eles que amarram o interpretador local ao do HA.
.venv/

# saídas regeneráveis do harness
.claude/output/*
!.claude/output/.gitkeep

# nunca versionar credencial de MCP
# .mcp.json carrega o token do proxy do HA no próprio URL — este repo é público
.mcp.json
.mcp.local.json
.claude/settings.local.json

# buffer do plugin remember
.remember/
